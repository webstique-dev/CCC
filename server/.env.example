# Server Port (Render sets process.env.PORT automatically)
PORT=8000

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/cargo_invoice?retryWrites=true&w=majority

# JWT Secret Key (Generate a random 32+ char string)
JWT_SECRET=your_strong_jwt_secret_key_change_in_production

# Frontend Client URL for CORS (e.g. Vercel deployment URL)
CLIENT_ORIGIN=https://your-cargo-client.vercel.app

# Secure Admin Account Configuration (Optional override)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here

# Environment Mode
NODE_ENV=production
